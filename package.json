{
  "name": "@lcluber/roostrjs",
  "version": "0.6.0",
  "description": "WebGL 3D engine written in TypeScript",
  "keywords": [
    "WebGL 3D engine"
  ],
  "homepage": "http://roostrjs.lcluber.com",
  "main": "dist/roostr.js",
  "module": "dist/roostr.js",
  "types": "dist/roostr.d.ts",
  "exports": {
    ".": {
      "types": "./dist/roostr.d.ts",
      "import": "./dist/roostr.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=14"
  },
  "bugs": {
    "url": "https://github.com/LCluber/RoostR.js/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LCluber/RoostR.js.git"
  },
  "license": "MIT",
  "author": {
    "name": "Ludovic Cluber",
    "url": "http://www.lcluber.com/",
    "email": "http://www.lcluber.com/contact"
  },
  "contributors": [],
  "scripts": {
    "prebuild": "npm install",
    "build": "node ./scripts/clear.cjs && tsc -p tsconfig.lib.json && npm run rollup && npm run uglify && node ./scripts/copy.cjs && npm run test",
    "rollup:mjs": "rollup --config rollup.config.mjs",
    "rollup:iife": "rollup --config rollup.config.iife.mjs",
    "rollup": "npm run rollup:mjs && npm run rollup:iife",
    "uglify": "uglifyjs build/roostr.iife.js --config-file uglify.config.json --output build/roostr.iife.min.js",
    "test": "jest --coverage"
  },
  "files": [
    "dist/"
  ],
  "dependencies": {
    "@lcluber/type6js": "3.0.0"
  },
  "devDependencies": {
    "@babel/core": "7.23.2",
    "@babel/preset-env": "7.23.2",
    "@rollup/plugin-babel": "6.0.4",
    "@rollup/plugin-node-resolve": "15.3.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "rollup": "4.24.0",
    "typescript": "5.6.3",
    "uglify-js": "3.19.3"
  }
}
